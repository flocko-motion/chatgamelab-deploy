#!/usr/bin/env bash
# Converge on the tracked branch. This is what both automatic routes run — the
# trigger's path unit and the fallback timer — through one systemd unit, so
# they serialise rather than race.
#
# It follows a branch, which is the one place a branch rather than a resolved
# commit decides what runs on the box. ./deploy.sh is the override: it names a
# commit, and that commit serves until the next tick brings the box back onto
# the branch.
. "$(dirname "$0")/lib.sh"

# Consumed first, and before the lock: the file's job is to say "something
# happened since the last run", and removing it now means a trigger arriving
# during this run leaves the path unit able to fire again afterwards rather
# than being swallowed.
rm -f "$HOOK_RUNTIME_DIR/trigger" 2>/dev/null || true

# systemd already serialises the two routes; this catches a hand-run alongside
# them. Non-blocking, because a second convergence on the same branch has
# nothing to add once the first is under way.
lock="$RUNTIME_HOME/.update.lock"
exec 9>"$lock"
if ! flock -n 9; then
  say "a deploy is already running — leaving it to finish"
  exit 0
fi

# Straight from the remote rather than the mirror, since the mirror belongs to
# the build user and this runs as the runtime user. One network call, and no
# local state that could be stale.
[ -n "${TRACK_BRANCH:-}" ] \
  || die "this instance follows no branch, so there is nothing to converge on." \
         "" \
         "It runs the release ./deploy.sh last named. To move it, name another:" \
         "" \
         "  ./deploy.sh $DOMAIN <release-tag>"

step "resolving $TRACK_BRANCH"
sha="$(git ls-remote "$APP_REPO" "refs/heads/$TRACK_BRANCH" | cut -f1)"
[ -n "$sha" ] || die "$APP_REPO has no branch $TRACK_BRANCH."
say "${sha:0:7}"

# A pulling instance runs published releases, so the branch head is only a
# candidate when CI tagged it. Untagged, there is nothing in the registry to
# deploy and the right answer is to wait for the next release rather than fail.
image_tag=""
if [ "${IMAGE_SOURCE:-build}" = "registry" ]; then
  tag="$(git ls-remote --tags "$APP_REPO" \
    | awk -v s="$sha" '$1 == s { print $2 }' \
    | sed -n 's#^refs/tags/\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$#\1#p' | head -1)"
  if [ -z "$tag" ]; then
    say "${sha:0:7} carries no release tag — waiting for one"
    exit 0
  fi
  image_tag="${tag#v}"
  say "release $tag"
fi

deployed="$(cat "$RUNTIME_HOME/deployed-ref" 2>/dev/null || true)"
if [ "$sha" = "$deployed" ]; then
  say "already at ${sha:0:7} — nothing to do"
  exit 0
fi
if [ -n "$deployed" ]; then
  say "box is at ${deployed:0:7}, branch has moved"
else
  say "box has nothing deployed yet"
fi

# Asked of the build user because the worktree is the only place the answer
# lives and only that account can read it. Cheap: a fetch and a checkout, no
# build.
# The migration high-water mark of the tree being deployed. A building
# instance has a worktree to read it from; a pulling one has no source at all,
# so it is read from the repository over https.
step "reading the target's migration mark"
if [ "${IMAGE_SOURCE:-build}" = "registry" ]; then
  target_migration="$(git ls-remote "$APP_REPO" >/dev/null 2>&1 && \
    curl -fsS "https://api.github.com/repos/${APP_REPO#https://github.com/}/contents/server/db/migrations?ref=$sha" \
    | sed -n 's/.*"name": *"0*\([0-9][0-9]*\)_.*/\1/p' | sort -n | tail -1)"
  [ -n "$target_migration" ] || die "could not read the migration set for $sha."
else
  target_migration="$(sudo -u "$BUILD_USER" "$DEPLOY_CLONE/box/cgl-build" \
    --app-sha "$sha" --print-migration)" \
    || die "could not prepare the worktree for $sha."
fi
say "up to $target_migration"

# The deploy repo stays where it is: an automatic run deploys application
# commits, never a change to the deployment itself. That remains ./deploy.sh's
# job, and is what keeps a push here from reaching the box on its own.
set -- --deploy-sha "$(git -C "$DEPLOY_CLONE" rev-parse HEAD)" \
       --app-sha "$sha" --target-migration "$target_migration"
[ -n "$image_tag" ] && set -- "$@" --image-tag "$image_tag"
exec "$DEPLOY_CLONE/box/cgl-deploy" "$@"
