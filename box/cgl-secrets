#!/usr/bin/env bash
# The backup destination: report what is configured and whether it works, or
# install what ./deploy.sh pushed.
#
# One genuine secret exists in this deployment — the SSH private key the
# database container uploads dumps with over SFTP (docker/db/backup.sh in the
# application repository). It is given interactively, once, and lives on the
# box from then on; nothing about it is ever in the repository, so the
# repository stays public and carries no ciphertext to rotate.
#
# The destination's host, port, user and path are given the same way rather
# than committed. They are not secrets, but they belong to whoever runs the
# instance, and an instance that changes hands should take its backup target
# with it rather than leave it in a file its new owner inherits.
. "$(dirname "$0")/lib.sh"

pushed="$RUNTIME_HOME/secrets.env"
backup_key="$RUNTIME_HOME/backup_key"

check_secrets() {
  local enabled bhost bport buser bpath
  enabled="$(secret_get BACKUP_ENABLED || echo false)"
  if [ "$enabled" != "true" ]; then
    say "backups are off — no destination configured"
    # Distinct from both "working" and "broken": there is nothing here to
    # replace, and ./deploy.sh words its question from that.
    return 2
  fi

  bhost="$(secret_get BACKUP_SSH_HOST)"
  bport="$(secret_get BACKUP_SSH_PORT)"; bport="${bport:-22}"
  buser="$(secret_get BACKUP_SSH_USER)"
  bpath="$(secret_get BACKUP_PATH)"

  if [ ! -r "$backup_key" ] || [ ! -s "$backup_key" ]; then
    say "backups are on and $backup_key is missing or empty"
    return 1
  fi

  # The cheapest question that proves the whole path: this key opens a session
  # on the host the dump will be written to, and the target directory is
  # reachable. Anything short of that finds out at 3am instead.
  if printf 'cd %s\nquit\n' "${bpath:-.}" | sftp -b - \
       -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=10 \
       -i "$backup_key" -P "$bport" "$buser@$bhost" >/dev/null 2>&1; then
    say "backups -> $buser@$bhost:$bport/${bpath:-.} — key accepted, path reachable"
    return 0
  fi
  say "backups -> $buser@$bhost:$bport — refused"
  echo "     the public half has to be in that account's authorized_keys:" >&2
  ssh-keygen -y -f "$backup_key" 2>/dev/null | sed 's/^/       /' >&2
  return 1
}

install_secrets() {
  [ -r "$pushed" ] || die "no $pushed to install — ./deploy.sh writes it."
  step "installing the backup destination"

  # Parsed rather than sourced: this arrived as a blob and sourcing it would
  # execute whatever it contains.
  local key_b64
  key_b64="$(sed -n 's/^BACKUP_SSH_KEY_B64=//p' "$pushed" | head -1)"

  if [ -n "$key_b64" ]; then
    # Mode before content, so the key is never briefly world-readable.
    : > "$backup_key"; chmod 600 "$backup_key"
    printf '%s' "$key_b64" | base64 -d > "$backup_key" 2>/dev/null \
      || die "BACKUP_SSH_KEY_B64 is not valid base64."
    ssh-keygen -y -f "$backup_key" >/dev/null 2>&1 \
      || die "that decodes to something ssh does not read as a private key."
    say "key installed — $(ssh-keygen -l -f "$backup_key" | awk '{print $1, $4}')"
  fi

  while IFS= read -r line; do
    case "$line" in
      BACKUP_SSH_KEY_B64=*|'#'*|'') continue ;;
      [A-Z]*=*) secret_set "${line%%=*}" "${line#*=}" ;;
    esac
  done < "$pushed"
  rm -f "$pushed"

  check_secrets
}

# The four values that are configuration rather than credential, so
# ./deploy.sh can offer them back as defaults. The key itself is never printed
# — only whether one is here.
show_secrets() {
  printf 'BACKUP_SSH_HOST=%s\n' "$(secret_get BACKUP_SSH_HOST || true)"
  printf 'BACKUP_SSH_PORT=%s\n' "$(secret_get BACKUP_SSH_PORT || true)"
  printf 'BACKUP_SSH_USER=%s\n' "$(secret_get BACKUP_SSH_USER || true)"
  printf 'BACKUP_PATH=%s\n'     "$(secret_get BACKUP_PATH || true)"
  if [ -s "$backup_key" ]; then
    printf 'HAS_KEY=%s\n' "$(ssh-keygen -l -f "$backup_key" 2>/dev/null | awk '{print $2}')"
  else
    printf 'HAS_KEY=\n'
  fi
}

case "${1:-}" in
  show)    show_secrets ;;
  check)   check_secrets ;;
  install) install_secrets ;;
  *) die "usage: cgl-secrets show|check|install" ;;
esac
