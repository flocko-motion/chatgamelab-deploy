# Managed by ansible (roles/cgl_box).
#
# Runs the application's own backup script inside the database container
# (docker/db/backup.sh), which pg_dumps, gzips and sends the result over SFTP.
# It exits 0 without doing anything while BACKUP_ENABLED is not "true".
[Unit]
Description=chatgamelab database backup

[Service]
Type=oneshot
User={{ runtime_user }}
Group={{ runtime_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ runtime_uid }}
# Through box/cgl-backup rather than straight at the container, so the nightly
# run and a hand-run are the same path — and so the destination is probed
# before a dump is taken. backup.sh calls sftp without BatchMode, so an
# unusable key makes it hang rather than fail, and a generous timeout would
# turn that into hours of nothing.
ExecStart={{ deploy_clone }}/box/cgl-backup now

# Enough for a media-heavy dump to upload, now that a dead destination is
# caught in seconds rather than consuming this.
TimeoutStartSec=2h
