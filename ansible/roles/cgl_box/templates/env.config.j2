# Managed by ansible (roles/cgl_box) — edits here are overwritten on the next
# ground sweep. Public configuration only; the secrets live in env.secret
# beside it, which ansible creates and never writes.
#
# Read by docker compose as one of two --env-file arguments (see box/cgl-stack).

# Postgres. The password is in env.secret.
DB_USER=chatgamelab
DB_DATABASE=chatgamelab
PORT_POSTGRES=5432

# Backend
PORT_BACKEND=3000
PUBLIC_URL=https://{{ inventory_hostname }}
API_BASE_URL=https://{{ inventory_hostname }}/api

# Auth0. All three are public identifiers: the client id is served to every
# visitor in /env.js (see the app repo's web/docker/entrypoint.sh, whose own
# comment reads "public values only - no secrets!"), and verification uses
# Auth0's published JWKS rather than any shared secret.
AUTH0_DOMAIN={{ auth0_domain }}
AUTH0_AUDIENCE={{ auth0_audience }}
AUTH0_CLIENT_ID={{ auth0_client_id }}

# Telemetry. A DSN is a write-only ingest URL, and the frontend's is served to
# the browser like the Auth0 values. Empty disables that side.
SENTRY_DSN_BACKEND={{ sentry_dsn_backend }}
SENTRY_DSN_FRONTEND={{ sentry_dsn_frontend }}

# Dev mode on, and DEV_JWT_SECRET absent. The two are safe apart and a total
# compromise together, so this pairing is load-bearing rather than incidental
# and box/cgl-deploy refuses to start a stack that breaks it.
#
# DEV_MODE registers two routes with no authentication at all
# (server/api/routes/router.go:81) — POST /api/users/new and
# GET /api/users/{id}/jwt. The second signs a token for whatever user id the
# URL names, and the dev admin ids are compile-time constants
# (server/db/preseed.go:20), so a non-empty DEV_JWT_SECRET would make one
# unauthenticated request enough to become admin. An empty secret makes
# GenerateToken refuse, which is what closes it.
#
# The nginx vhost additionally refuses both routes at the edge, so dev mode's
# useful half — the preseeded accounts and debug logging — costs nothing.
DEV_MODE=true

# Database backups are off. Turning them on means an SSH credential on the box
# and a destination that can hold users' plaintext provider keys
# (server/db/schema.sql:202), so it is a deliberate piece of work rather than a
# flag to flip here.
BACKUP_ENABLED=false

# Half of each image reference; box/cgl-deploy supplies IMAGE_TAG per deploy.
# localhost for a box that builds, the registry for one that pulls.
IMAGE_PREFIX={{ 'localhost' if image_source == 'build' else image_registry }}

# Where the web container publishes. nginx on the host proxies to it and is the
# only public listener; a rootless container could not bind 80 regardless.
WEB_BIND_ADDRESS={{ web_bind_address }}
WEB_BIND_PORT={{ web_bind_port }}
