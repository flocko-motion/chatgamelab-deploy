# Managed by ansible (roles/cgl_box). The paths phase two works with, written
# here rather than hardcoded in box/ because box/ comes from git and these come
# from group_vars — so there is one definition of where things live.
RUNTIME_USER={{ runtime_user }}
RUNTIME_HOME={{ runtime_home }}
BUILD_USER={{ build_user }}
BUILD_HOME={{ build_home }}
APP_MIRROR={{ app_mirror }}
APP_WORKTREE={{ app_worktree }}
HANDOFF_DIR={{ handoff_dir }}
DEPLOY_CLONE={{ deploy_clone }}
DOMAIN={{ inventory_hostname }}
APP_REPO={{ app_repo }}
IMAGE_SOURCE={{ image_source }}
# Empty on a host that follows nothing — production names a release rather
# than tracking a branch, so box/cgl-update has nothing to converge on there.
TRACK_BRANCH={{ track_branch | default('') }}
HOOK_RUNTIME_DIR={{ hook_runtime_dir }}
WEB_BIND_ADDRESS={{ web_bind_address }}
WEB_BIND_PORT={{ web_bind_port }}
