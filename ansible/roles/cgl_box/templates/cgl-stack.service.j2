# Managed by ansible (roles/cgl_box).
#
# Brings the stack back after a reboot. Rootless podman has no daemon to
# restore restart policies, and unattended-upgrades reboots this box for a
# kernel update — so without this the site stays down until somebody notices.
[Unit]
Description=chatgamelab stack
# The user manager owns podman's socket, so this has to follow it. Ordering
# alone is not enough — the socket appears some way into that manager's own
# startup — so box/cgl-stack waits for the socket as well.
After=network-online.target user@{{ runtime_uid }}.service
Wants=network-online.target user@{{ runtime_uid }}.service

[Service]
Type=oneshot
RemainAfterExit=yes
User={{ runtime_user }}
Group={{ runtime_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ runtime_uid }}
ExecStart={{ deploy_clone }}/box/cgl-stack up
# Deliberately no ExecStop: a stop of this unit during shutdown must not tear
# the stack down in a way that a deploy would then have to undo. The containers
# stop with the machine.
TimeoutStartSec=15min
# A boot that loses the race anyway gets another go, rather than leaving the
# site down until somebody looks.
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
